{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/lib/*": [
        "./src/lib/*"
      ],
      "@repo/utils/*": [
        "./src/utils/*"
      ],
      "@repo/types/*": [
        "./src/types/*"
      ],
      "@repo/db/*": [
        "./src/db/*"
      ]
    },
    "rootDir": "." /* Specify the root folder within your source files. */,
    "outDir": "./dist" /* Specify an output folder for all emitted files. */,
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "incremental": true,
    "skipLibCheck": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "drizzle",
    "**/*.test.ts"
  ]
}