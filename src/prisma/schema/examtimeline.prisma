enum EventStatus {
    completed
    current
    upcoming
}

// time line info 
model ExamTimeline {
    id           String     @id @default(uuid())
    title        String
    date         DateTime
    description  String?
    status       ExamStatus
    notification String?
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @updatedAt
    exam_year    String
    Exam_year    ExamYear   @relation(fields: [exam_year], references: [id])
}
