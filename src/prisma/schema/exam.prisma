model TargetExam {
  id          String    @id @default(cuid())
  name        String    @unique // e.g., "GATE", "UPSC"
  shortCode   String?   @unique // e.g., "GATE", "CAT", "UPSC"
  description String?
  examScope   ExamScope @default(NATIONAL) // examType to ExamScope
  isPublic    Boolean   @default(false)
  categoryId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // relation
  Category          Category?           @relation(fields: [categoryId], references: [id])
  subcriptionOffers subcriptionOffers[]
  examYears         ExamYear[]
}

model ExamYear {
  id                    String         @id @default(cuid())
  targetExamId          String
  year                  Int // e.g., 2025
  slug                  String         @unique // e.g., "gate-2025"
  status                ExamStatus     @default(SCHEDULED)
  isPublic              Boolean        @default(false)
  registrationOpenDate  DateTime?
  registrationCloseDate DateTime?
  examDate              DateTime?
  resultDate            DateTime?
  notes                 Json? // flexible field for extra info
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  isDeleted             Boolean        @default(false)
  // relation
  targetExam            TargetExam     @relation(fields: [targetExamId], references: [id])
  Syllabus              Syllabus[]
  ExamTimeline          ExamTimeline[]
}

model Exam_pattern {
  id              String        @id @unique @default(cuid())
  title           String?       @unique
  format          examformat    @default(Text) // it not needed 
  examname        String
  categoryId      String?
  Category        Category?     @relation(fields: [categoryId], references: [id])
  syllabus        syllabusType  @default(Syllabus) // Syllabus mean it follow syllabus base question paper
  syllabusid      String?
  topics          String[]
  difficulty      diffcultlevel @default(Easy)
  part            Boolean?
  checkbox        Boolean?
  part_Count      Int           @default(1)
  total_questions Int[]
  check           check?
  marks_values    Int[]
  neg_values      Int[]
  is_multiple_ans Int[]         @default([0, 0]) // 0 mean false 1 mean it is multiple value ans
  created_by      String
  Exam            Exam[]
  User            User          @relation(fields: [created_by], references: [id])
}

model Exam {
  id               String        @id @unique @default(cuid())
  display_id       String?       @unique @default(nanoid(6))
  name             String?       @default("No name")
  examtype         ExamType      @default(Test)
  access_type      access_type   @default(Paid)
  exam_pattern_id  String
  isMultipleAttemp Boolean       @default(true)
  isLive           Boolean       @default(true)
  Visibility       Visibility    @default(Private)
  creationstatus   CreationTypes @default(Processing)
  starttime        String?       @default("08:00 pm") //or no limit // -> it start time , at this time you can join the exam , and join process open starttime + jointime 
  jointime         String?       @default("00:15 m") // Open HH:MM:SS
  duration         String        @default("02:00 h") // HH:MM   it is time  user can give or mark ans  , ans accept onlt starttime+jointime+timelimit+ 00:10 min
  date             DateTime      @default(now())
  stage            ExamStage     @default(Registration)
  register_id      String        @default("")

  question_difficulty_weight Json? // { "Easy": 0, "MEDIUM": 0, "HARD": 0 }
  question_topic_count       Json? // { "OS": 0, "DBMS": 0, "C": 0 }
  question_part_count        Json? // { "part1": 0, "part2": 0 }

  created_at DateTime? @default(now())
  created_by String

  ContestRegister ContestRegister @relation(fields: [register_id], references: [id])
  User            User            @relation(fields: [created_by], references: [id])
  exam_pattern    Exam_pattern    @relation(fields: [exam_pattern_id], references: [id])
  leaderboard     leaderboard[]
  questionsMap    question_map[]  @relation("ExamRelation")

  @@index([examtype])
}

enum access_type {
  Free
  Paid
}

enum ExamScope {
  NATIONAL
  STATE
  COLLEGE
  OTHER
}

enum ExamStatus {
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  SCHEDULED
  ONGOING
  COMPLETED
  EVALUATION_IN_PROGRESS
  RESULT_PUBLISHED
  ARCHIVED
}

enum ExamType {
  Test // dynamic exam set 
  Contest // compeations
  Mock // for fixed question set like 2024 jeca set 
  PYQ // 2024 jeca Exam 
  Subject // for topic 30 question
  Dpp
  Quiz
}
